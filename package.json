{
  "name": "kcru-website",
  "version": "1.0.0",
  "description": "KCRU website built with Next.js, Sanity CMS, and Tailwind CSS.",
  "main": "app/page.js",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "studio": "sanity dev",
    "refresh:pubmed": "node --import ./scripts/_preload-env.js scripts/refresh-pubmed-cache.js",
    "import:research-digest": "node --import ./scripts/_preload-env.js scripts/import-research-digest.js",
    "reselect:research-digest": "node --import ./scripts/_preload-env.js scripts/import-research-digest.js --select-only",
    "reclassify:pubmed": "node --import ./scripts/_preload-env.js scripts/reclassify-pubmed.js",
    "clear:pubmed": "node --import ./scripts/_preload-env.js scripts/clear-pubmed-cache.js",
    "upload:pubmed": "node --import ./scripts/_preload-env.js scripts/upload-cache-to-sanity.js",
    "audit:publication-attribution": "node --import ./scripts/_preload-env.js scripts/audit-publication-attribution.js",
    "migrate:publication-attribution": "node --import ./scripts/_preload-env.js scripts/migrate-publication-attribution-reviews.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
